    fill.Filled = false
    fill.Transparency = 1
    fill.Visible = false

    box.outline = outline
    box.fill = fill
    box.corner_fill = {}
    box.corner_outline = {}

    for i = 1, 8 do
        local o = Drawing.new("Line")
